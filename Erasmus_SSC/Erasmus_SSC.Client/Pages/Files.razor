@page "/files"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject AuthenticationStateProvider AuthProvider
@inject UserFilesApiClient FilesApi
@inject IJSRuntime JS

<div class="files-page">
    <div class="files-shell">
        <div class="files-header">
            <h1>Files</h1>
            <p class="files-subtitle">
                Share materials with other users and manage uploaded files in one place.
            </p>
        </div>

        @if (!_isAuthenticated)
        {
            <div class="files-message-card">
                <p>Please log in to use the shared files area.</p>
            </div>
        }
        else
        {
            <div class="upload-card">
                <div class="upload-card__content">
                    <label class="upload-label">Upload a file</label>

                    <div class="upload-box">
                        <InputFile OnChange="OnFileSelected" class="file-input" />

                        <button class="btn-primary"
                                @onclick="UploadAsync"
                                disabled="@(_selectedFile is null || _busy)">
                            Upload
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_selectedFileName))
                    {
                        <p class="selected-file">Selected file: @_selectedFileName</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="files-error">@_error</div>
                    }
                </div>
            </div>

            @if (_loading)
            {
                <div class="files-message-card">
                    <p>Loading files...</p>
                </div>
            }
            else if (_files.Count == 0)
            {
                <div class="files-message-card">
                    <p>No files uploaded yet.</p>
                </div>
            }
            else
            {
                <div class="files-table-wrap">
                    <table class="files-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Uploader</th>
                                <th>Uploaded</th>
                                <th>Size</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var file in _files)
                            {
                                <tr>
                                    <td class="file-name-cell">@file.FileName</td>
                                    <td>@file.OwnerUserName</td>
                                    <td>@file.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@FormatBytes(file.SizeBytes)</td>
                                    <td>
                                        <div class="file-actions">
                                            <button class="btn-primary"
                                                    @onclick="() => DownloadAsync(file)"
                                                    disabled="@_busy">
                                                Download
                                            </button>

                                            @if (CanDeleteFile(file))
                                            {
                                                <button class="btn-delete"
                                                        @onclick="() => DeleteAsync(file.Id)"
                                                        disabled="@_busy">
                                                    Delete
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<UserFileItemDto> _files = new();
    private IBrowserFile? _selectedFile;
    private string? _selectedFileName;
    private string? _error;
    private bool _loading = true;
    private bool _busy;
    private bool _isAuthenticated;
    private int? _currentUserId;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;

        _isAuthenticated = user.Identity?.IsAuthenticated == true;

        if (_isAuthenticated)
        {
            var userIdClaim = user.FindFirst("sub")?.Value
                              ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (int.TryParse(userIdClaim, out var parsedUserId))
                _currentUserId = parsedUserId;

            _isAdmin = user.IsInRole("Admin");

            await LoadFilesAsync();
        }

        _loading = false;
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.FileCount > 0 ? e.File : null;
        _selectedFileName = _selectedFile?.Name;
        _error = null;
    }

    private async Task LoadFilesAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _files = await FilesApi.GetFilesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _files = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UploadAsync()
    {
        if (_selectedFile is null)
            return;

        _busy = true;
        _error = null;

        try
        {
            await FilesApi.UploadAsync(_selectedFile);
            _selectedFile = null;
            _selectedFileName = null;
            await LoadFilesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadAsync(UserFileItemDto file)
    {
        _busy = true;
        _error = null;

        try
        {
            var result = await FilesApi.DownloadAsync(file.Id);
            var base64 = Convert.ToBase64String(result.Bytes);

            await JS.InvokeVoidAsync(
                "fileDownload.saveAsBase64",
                result.FileName,
                result.ContentType,
                base64);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatBytes(int bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1024.0 / 1024.0:F1} MB";
    }
    private bool CanDeleteFile(UserFileItemDto file)
    {
        if (!_isAuthenticated)
            return false;

        if (_isAdmin)
            return true;

        return _currentUserId.HasValue && file.OwnerUserId == _currentUserId.Value;
    }
    private async Task DeleteAsync(int fileId)
    {
        _busy = true;
        _error = null;

        try
        {
            await FilesApi.DeleteAsync(fileId);
            await LoadFilesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

}