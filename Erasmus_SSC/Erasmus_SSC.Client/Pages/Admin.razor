@page "/admin"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using Erasmus_SSC.Client.Dtos
@using Erasmus_SSC.Client.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject AdminUsersApiClient AdminApi
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<section class="admin-section">
    <div class="admin-overlay"></div>

    <div class="admin-container">
        <h1 class="admin-title">Admin Dashboard</h1>

        <div class="admin-card">
            <h2>Users</h2>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="login__error">@_error</div>
            }

            <div class="admin-actions">
                <button class="btn-primary" @onclick="ShowAddUser">Add User</button>

                @if (showAddUserForm)
                {
                    <div class="admin-form-popup">
                        <div class="admin-form">
                            <h3>Add New User</h3>

                            <div class="form-group">
                                <label>Username</label>
                                <input class="form-input" @bind="newUser.UserName" />
                            </div>

                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" class="form-input" @bind="newUser.Email" />
                            </div>

                            <div class="form-group">
                                <label>Password</label>
                                <input type="password" class="form-input" @bind="newUser.Password" />
                            </div>

                            <div class="form-buttons">
                                <button class="btn-primary" @onclick="SaveUserAsync" disabled="@_busy">Save</button>
                                <button class="btn-cancel" @onclick="CancelAddUser" disabled="@_busy">Cancel</button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (_loading)
            {
                <p>Loading users...</p>
            }
            else
            {
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th style="width:120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Users)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.Email</td>
                                <td>@user.UserRole</td>
                                <td>
                                    <button class="btn-small btn-danger"
                                            disabled="@_busy"
                                            @onclick="() => DeleteUserAsync(user.Id)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

       
        <div class="admin-card">
            <h2>News</h2>
            
        </div>
    </div>
</section>

@code {
    private bool _loading = true;
    private bool _busy = false;
    private string? _error;

    private bool showAddUserForm = false;
    private AdminCreateUserDto newUser = new();

    public List<AdminUserDto> Users { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _error = null;
        _loading = true;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var principal = state.User;

        if (principal.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (!principal.IsInRole("Admin"))
        {
            _error = "Access denied: Admin role required.";
            Nav.NavigateTo("/");
            return;
        }

        await ReloadUsersAsync();
    }


    private async Task ReloadUsersAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            Users = await AdminApi.GetUsersAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ShowAddUser()
    {
        _error = null;
        showAddUserForm = true;
    }

    private void CancelAddUser()
    {
        showAddUserForm = false;
        newUser = new AdminCreateUserDto();
    }

    private async Task SaveUserAsync()
    {
        _error = null;
        _busy = true;

        try
        {
            var created = await AdminApi.CreateUserAsync(new AdminCreateUserDto
            {
                UserName = newUser.UserName.Trim(),
                Email = newUser.Email.Trim(),
                Password = newUser.Password
            });

            Users.Add(created);
            showAddUserForm = false;
            newUser = new AdminCreateUserDto();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteUserAsync(int id)
    {
        _error = null;
        _busy = true;

        try
        {
            await AdminApi.DeleteUserAsync(id);
            Users.RemoveAll(u => u.Id == id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
