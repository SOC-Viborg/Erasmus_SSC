@page "/news"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using System.Net.Http.Json
@using Erasmus_SSC.Client.Dtos
@inject HttpClient Http;
@inject NavigationManager Nav;

<div class="body">
    <div class="title"><strong>News</strong></div>
    <hr />

    @if (_loading)
    {
        <p class="news-status">Loading news...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="news-status news-status--error">@_error</p>
    }
    else if (NewsItems.Count == 0)
    {
        <p class="news-status">No news yet</p>
    }
    else
    {
        @foreach (var item in NewsItems)
        {
            <div class="content">
                <h3>@item.Title</h3>
                <p class="news-date">@item.Date.ToString("yyyy-MM-dd")</p>
                <p>@((MarkupString)item.Description)</p>

                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Title" class="news-image" />
                }

                <hr />
            </div>
        }
    }

    <hr />
</div>


@code {
    private List<PublicNewsDto> NewsItems = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            
            NewsItems = await Http.GetFromJsonAsync<List<PublicNewsDto>>("/api/news") ?? new();

            NewsItems = NewsItems
                .OrderByDescending(x => x.Date)
                .ToList();
        }
        catch (Exception ex)
        {
            _error = "Failed to load news: " + ex.Message;
            Console.Error.WriteLine(ex);
            NewsItems = new();
        }
        finally
        {
            _loading = false;
        }
    }
}
